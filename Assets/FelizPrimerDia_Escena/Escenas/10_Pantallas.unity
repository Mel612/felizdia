--- !u!114 &2082085845
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2082085843}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 36
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.1
  m_Text: "<size=96><b>FELIZ PRIMER D\xCDA</b></size>\n<size=30><color=#ffd166>UNIFRANZ 
    \xB7  SEDE LA PAZ</color></size>\n\n\n\n<size=28><color=#999999>Un juego de</color></size>\n<size=54><b><color=#ffd166>TRES
    NEURONAS Y UN CROMOSOMA</color></b></size>\n\n\n\n<size=26><color=#999999>Historia
    y guion</color></size>\n<size=36><color=#ffd166>TRES NEURONAS Y UN CROMOSOMA</color></size>\n\n<size=26><color=#999999>Programaci\xF3n</color></size>\n<size=36><color=#ffd166>TRES
    NEURONAS Y UN CROMOSOMA</color></size>\n\n<size=26><color=#999999>Arte en pixel
    art</color></size>\n<size=36><color=#ffd166>TRES NEURONAS Y UN CROMOSOMA</color></size>\n\n<size=26><color=#999999>M\xFAsica
    y efectos de sonido</color></size>\n<size=36><color=#ffd166>TRES NEURONAS Y UN
    CROMOSOMA</color>\n<size=24><color=#999999>(generados por c\xF3digo, nota por
    nota)</color></size></size>\n\n<size=26><color=#999999>Cinem\xE1ticas</color></size>\n<size=36><color=#ffd166>TRES
    NEURONAS Y UN CROMOSOMA</color></size>\n\n\n\n<size=30><color=#e63946>REPARTO</color></size>\n<size=40>Valeria
    Quispe</size>\n<size=24><color=#999999>la cachimba que vive su primer d\xEDa
    una y otra vez</color></size>\n\n<size=40>Mateo Choque</size>\n<size=24><color=#999999>Ing.
    de Sistemas, el que lo vio todo por las c\xE1maras</color></size>\n\n<size=40>Camila</size>\n<size=24><color=#999999>la
    delegada que recuerda</color></size>\n\n<size=40>Andrea</size>\n<size=40>Diego</size>\n<size=40>Sebasti\xE1n</size>\n<size=40>Don
    Teodoro</size>\n<size=24><color=#999999>guardia de Seguridad</color></size>\n\n<size=40>Ing.
    Ramiro Vargas</size>\n<size=40>Do\xF1a Rosa</size>\n<size=40>Mart\xEDn</size>\n<size=40>Luc\xEDa</size>\n<size=40>Joaqu\xEDn</size>\n<size=40>Paola</size>\n<size=40>Ariel</size>\n<size=40>Iv\xE1n</size>\n<size=40>Marcos</size>\n<size=40>Nico</size>\n<size=40>Gabriela</size>\n<size=40>Lucero</size>\n<size=40>Fernanda</size>\n\n<size=40>La
    \xF1atita</size>\n\n<size=48><color=#7bd389>EL PEPINO</color></size>\n<size=24><color=#999999>como
    \xE9l mismo</color></size>\n\n\n\n<size=30><color=#e63946>CARRERAS QUE CONOCISTE</color></size>\n<size=32>Medicina 
    \xB7  Derecho  \xB7  Periodismo  \xB7  Ingenier\xEDa de Sistemas\nPsicolog\xEDa 
    \xB7  Administraci\xF3n de Empresas  \xB7  Econom\xEDa  \xB7  Contadur\xEDa P\xFAblica\nDise\xF1o
    Gr\xE1fico  \xB7  Publicidad y Marketing  \xB7  Hoteler\xEDa y Turismo\nOdontolog\xEDa 
    \xB7  Bioqu\xEDmica y Farmacia  \xB7  Ingenier\xEDa Comercial</size>\n\n\n\n<size=30><color=#e63946>INSPIRADO
    EN</color></size>\n<size=40>Feliz d\xEDa de tu muerte</size>\n<size=40>Resident
    Evil</size>\n<size=40>Five Nights at Freddy's</size>\n\n\n\n<size=30><color=#e63946>GRACIAS
    A</color></size>\n<size=40>Unifranz, sede La Paz</size>\n<size=28><color=#bbbbbb>y
    a todos los que probaron el juego y murieron muchas veces</color></size>\n\n\n\n\n<size=30><color=#bbbbbb>Dedicado
    a todos los cachimbos que alguna vez\nse perdieron buscando el aula en su primer
    d\xEDa.</color></size>\n\n\n\n\n\n<size=60><b>GRACIAS POR JUGAR</b></size>\n\n\n\n\n\n\n\n<size=26><color=#7bd389>...
    nos vemos en la pr\xF3xima Bienvenida.</color></size>"
