  m_Text: "<b>GUARDAR PARTIDA</b>\n\n<color=#ff4d4d>> </color><color=#ffd166>ESPACIO
    1</color>   <color=#777777>\u2014 vac\xEDo \u2014</color>\n\n   <color=#ffd166>ESPACIO
    2</color>   <color=#777777>\u2014 vac\xEDo \u2014</color>\n\n   <color=#ffd166>ESPACIO
    3</color>   <color=#777777>\u2014 vac\xEDo \u2014</color>\n\n   Cancelar\n\n<size=20><color=#888888>Arriba/abajo
    o 1-3: elegir \xB7 E: aceptar \xB7 Esc: cancelar</color></size>"
