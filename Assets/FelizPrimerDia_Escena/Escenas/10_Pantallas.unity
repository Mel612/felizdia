  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 34
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<size=24><b>LOGROS  1/27</b>\n\n<color=#2d6a4f>\u25A0 <b>Bienvenida al
    bucle</b> \u2014 Morir por primera vez.</color>\n<color=#9a8a75>\u25A1 <b>???</b>
    \u2014 Morir de las 6 formas distintas.</color>\n<color=#9a8a75>\u25A1 <b>???</b>
    \u2014 Conocer las 14 carreras.</color>\n<color=#9a8a75>\u25A1 <b>???</b> \u2014
    Juntar los 4 sellos en un mismo d\xEDa.</color>\n<color=#9a8a75>\u25A1 <b>???</b>
    \u2014 Juntar las 4 pruebas en un mismo d\xEDa.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Llegar a las 18:00 con los 4 sellos sin que el Pepino te vea.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Escapar de 3 persecuciones.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Encontrar las 8 grabaciones de Camila.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Llevarle la ofrenda completa a la \xF1atita.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Evacuar a tiempo durante un simulacro.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Conseguir las 4 indumentarias en un mismo d\xEDa.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Desbloquear a Mateo.</color>\n<color=#9a8a75>\u25A1 <b>???</b>
    \u2014 Escribir la advertencia en el directorio (Mateo).</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Final de Mateo: proyectar la verdad.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 El final verdadero de Mateo.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Final de Mateo: quedarse mirando.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Final de Mateo: aceptar la plata de Sebasti\xE1n.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Sobrevivir la Noche 1 en el cuarto secreto.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Sobrevivir la Noche 3 en el cuarto secreto.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Desenmascarar a Camila frente a todos.</color>\n<color=#9a8a75>\u25A1
    <b>???</b> \u2014 Perdonar.</color>\n<color=#9a8a75>\u25A1 <b>???</b> \u2014
    El final de la \xF1atita.</color>\n<color=#9a8a75>\u25A1 <b>???</b> \u2014 El
    final oscuro.</color>\n<color=#9a8a75>\u25A1 <b>???</b> \u2014 Acusar a la persona
    equivocada.</color>\n<color=#9a8a75>\u25A1 <b>???</b> \u2014 Quedarte sin bucles
    en Pesadilla.</color>\n<color=#9a8a75>\u25A1 <b>???</b> \u2014 Romper el bucle
    en dificultad Pesadilla.</color>\n<color=#9a8a75>\u25A1 <b>???</b> \u2014 Romper
    el bucle en modo Contrarreloj.</color>\n</size>"
