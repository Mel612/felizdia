    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<b><color=#8ecae6>MISIONES</color></b>\n<size=20><color=#999999>Valeria 
    \xB7  D\xEDa 1  \xB7  10:15</color></size>\n\n<color=#ffd166>1.  Toga y corbata:
    habla con Do\xF1a Rosa</color>\n<size=19>      <color=#7bd389>en este piso</color></size>\n\n<color=#bbbbbb>2. 
    Credencial de prensa: habla con Joaqu\xEDn</color>\n<size=19>      <color=#8ecae6>Piso
    2</color></size>\n\n<color=#bbbbbb>3.  Bata y barbijo: habla con Ariel</color>\n<size=19>     
    <color=#8ecae6>Piso 3</color></size>\n\n<color=#bbbbbb>4.  Tarjeta del laboratorio:
    habla con Iv\xE1n</color>\n<size=19>      <color=#8ecae6>Piso 4</color></size>\n\n"
