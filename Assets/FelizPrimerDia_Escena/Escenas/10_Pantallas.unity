--- !u!114 &1688620340
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1688620338}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 34
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<color=#7bd389><b>1.  CACHIMBO</b></color>\n<size=24><color=#bbbbbb>F\xE1cil.
    El Pepino es lento y no aprende. M\xE1s tiempo en los minijuegos.\nUna pista
    extra cada vez que mueres y el pasaporte te dice a d\xF3nde ir.</color></size>\n\n<color=#ffd166><b>2. 
    UNIVERSITARIO</b></color>\n<size=24><color=#bbbbbb>Normal. Como fue pensado el
    juego. El Pepino aprende de tus muertes.</color></size>\n\n<color=#f4a261><b>3. 
    TITULACI\xD3N</b></color>\n<size=24><color=#bbbbbb>Dif\xEDcil. El Pepino es m\xE1s
    r\xE1pido, ve m\xE1s lejos y aprende m\xE1s r\xE1pido.\nMenos tiempo en los minijuegos.</color></size>\n\n<color=#ff4d4d><b>4. 
    PESADILLA</b></color>\n<size=24><color=#bbbbbb>Solo tienes 5 BUCLES para romper
    el d\xEDa. En la fiesta hay 6 Pepinos.\nEl Pepino es rapid\xEDsimo. Si se acaban
    los bucles... final especial.</color></size>\n\n"
