    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<b>OPCIONES</b>\n\n<color=#ff4d4d>> M\xFAsica</color>\n      <color=#ffd166>||||||||||</color><color=#555555>||||||||||</color> 
    50%\n\n   Efectos\n      <color=#ffd166>||||||||||||||||||</color><color=#555555>||</color> 
    90%\n\n   Brillo\n      <color=#ffd166>||||||||||</color><color=#555555>||||||||||</color> 
    50%\n\n   C\xE1mara\n      <color=#ffd166>[CERCA]</color>  <color=#777777> NORMAL
    </color>  <color=#777777> LEJOS </color>  \n\n   Volver\n\n<size=22><color=#888888>Arriba/abajo:
    elegir \xB7 Izquierda/derecha: cambiar \xB7 E: aceptar</color></size>"
